# ---------------------------------------------------------------------------
# Нормализация переводов строк
# В репозитории текст хранится с LF; в рабочей копии — LF, кроме файлов
# Visual Studio, которым нужен CRLF.
# ---------------------------------------------------------------------------
* text=auto eol=lf

*.sln      text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.user     text eol=crlf
*.resx     text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---------------------------------------------------------------------------
# Бинарные файлы (не нормализовать и не показывать diff как текст)
# ---------------------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.pdb   binary
*.nupkg binary
*.zip   binary
*.7z    binary
